# Dapatkan dari https://my.telegram.org (bukan BotFather)
TG_API_ID=
TG_API_HASH=
TG_SESSION_PATH=data/personal_session
DATABASE_PATH=data/assistant.db

AUTO_REPLY_DELAY_SECONDS=180
MAX_BUFFER_MESSAGES=5
MAX_BUFFER_CHARS=3000
ADMIN_CLI=true

# llama-server lokal: --alias qwen3-0.6b --host 127.0.0.1 --port 8080
# Jangan arahkan ke host publik: pesan pengguna dikirim ke endpoint ini.
LLM_BASE_URL=http://127.0.0.1:8080
LLM_MODEL=qwen3-0.6b
LLM_ALLOW_REMOTE=false
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=160
LLM_TEMPERATURE=0.2

KNOWLEDGE_DIR=knowledge
RAG_TOP_K=3
LOG_LEVEL=INFO
